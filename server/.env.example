# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Current local default: MariaDB/MySQL.
# PostgreSQL option: DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=django.db.backends.mysql
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-your-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Browser JWT cookies
JWT_ACCESS_COOKIE_NAME=sc_access
JWT_REFRESH_COOKIE_NAME=sc_refresh
JWT_ACCESS_COOKIE_PATH=/api/v1/
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# JWT_COOKIE_DOMAIN=

# Email confirmation links
FRONTEND_BASE_URL=http://localhost:4200

# SMTP provider.
# For Gmail, use an app password, never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-provider-app-password
SMTP_FROM=your-email@gmail.com

# Django email settings.
# Port 465 uses implicit SSL; port 587 uses EMAIL_USE_TLS=True and EMAIL_USE_SSL=False.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND = "django.core.mail.backends.console.EmailBackend"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-provider-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
